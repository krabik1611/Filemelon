{
  "name": "filemelon",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/check-styles.cjs",
    "watch": "ng build --watch --configuration development",
    "tauri": "tauri",
    "build:prod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Mode installer",
    "build:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1 -Mode portable",
    "check": "tsc --noEmit -p tsconfig.app.json && node scripts/check-release.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.1",
    "@angular/compiler": "^22.0.1",
    "@angular/core": "^22.0.1",
    "@angular/forms": "^22.0.1",
    "@angular/platform-browser": "^22.0.1",
    "@tauri-apps/api": "^2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.1",
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
